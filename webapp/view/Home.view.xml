<mvc:View
    controllerName="cornelsen.talent.portal.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout">
    <Page showHeader="false" enableScrolling="true" class="sapUiContentPadding">
        <content>
            <!-- Hero Section -->
            <VBox class="cornelsenHero sapUiMediumMarginBottom">
                <Title text="{i18n>homeWelcome}, Anna!" class="cornelsenHeroTitle sapUiTinyMarginBottom"/>
                <Text text="{i18n>homeSubtitle}" class="cornelsenHeroSubtitle"/>
            </VBox>

            <!-- KPI Cards -->
            <layout:Grid defaultSpan="L3 M6 S12" class="sapUiSmallMarginBottom">
                <layout:content>
                    <f:Card class="cornelsenKpiCard cornelsenKpiBlue sapUiTinyMarginBottom">
                        <f:content>
                            <VBox class="sapUiSmallMargin" justifyContent="SpaceBetween" height="100px">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox>
                                        <Text text="{dashboard>/KPIs/0/title}" class="sapUiTinyMarginBottom"/>
                                        <Text text="{dashboard>/KPIs/0/value}" class="cornelsenKpiValue"/>
                                    </VBox>
                                    <VBox class="cornelsenKpiIconWrap" justifyContent="Center" alignItems="Center">
                                        <core:Icon src="{dashboard>/KPIs/0/icon}" size="1.5rem"/>
                                    </VBox>
                                </HBox>
                                <ObjectStatus text="{dashboard>/KPIs/0/trend}" state="{dashboard>/KPIs/0/trendState}" class="cornelsenKpiTrend"/>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <f:Card class="cornelsenKpiCard cornelsenKpiTeal sapUiTinyMarginBottom">
                        <f:content>
                            <VBox class="sapUiSmallMargin" justifyContent="SpaceBetween" height="100px">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox>
                                        <Text text="{dashboard>/KPIs/1/title}" class="sapUiTinyMarginBottom"/>
                                        <Text text="{dashboard>/KPIs/1/value}" class="cornelsenKpiValue"/>
                                    </VBox>
                                    <VBox class="cornelsenKpiIconWrap" justifyContent="Center" alignItems="Center">
                                        <core:Icon src="{dashboard>/KPIs/1/icon}" size="1.5rem"/>
                                    </VBox>
                                </HBox>
                                <ObjectStatus text="{dashboard>/KPIs/1/trend}" state="{dashboard>/KPIs/1/trendState}" class="cornelsenKpiTrend"/>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <f:Card class="cornelsenKpiCard cornelsenKpiOrange sapUiTinyMarginBottom">
                        <f:content>
                            <VBox class="sapUiSmallMargin" justifyContent="SpaceBetween" height="100px">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox>
                                        <Text text="{dashboard>/KPIs/2/title}" class="sapUiTinyMarginBottom"/>
                                        <Text text="{dashboard>/KPIs/2/value}" class="cornelsenKpiValue"/>
                                    </VBox>
                                    <VBox class="cornelsenKpiIconWrap" justifyContent="Center" alignItems="Center">
                                        <core:Icon src="{dashboard>/KPIs/2/icon}" size="1.5rem"/>
                                    </VBox>
                                </HBox>
                                <ObjectStatus text="{dashboard>/KPIs/2/trend}" state="{dashboard>/KPIs/2/trendState}" class="cornelsenKpiTrend"/>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <f:Card class="cornelsenKpiCard cornelsenKpiGreen sapUiTinyMarginBottom">
                        <f:content>
                            <VBox class="sapUiSmallMargin" justifyContent="SpaceBetween" height="100px">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox>
                                        <Text text="{dashboard>/KPIs/3/title}" class="sapUiTinyMarginBottom"/>
                                        <Text text="{dashboard>/KPIs/3/value}" class="cornelsenKpiValue"/>
                                    </VBox>
                                    <VBox class="cornelsenKpiIconWrap" justifyContent="Center" alignItems="Center">
                                        <core:Icon src="{dashboard>/KPIs/3/icon}" size="1.5rem"/>
                                    </VBox>
                                </HBox>
                                <ObjectStatus text="{dashboard>/KPIs/3/trend}" state="{dashboard>/KPIs/3/trendState}" class="cornelsenKpiTrend"/>
                            </VBox>
                        </f:content>
                    </f:Card>
                </layout:content>
            </layout:Grid>

            <!-- Quick Actions + Recent Hires -->
            <layout:Grid defaultSpan="L8 M12 S12" class="sapUiSmallMarginBottom">
                <layout:content>
                    <f:Card class="cornelsenContentCard">
                        <f:content>
                            <VBox>
                                <Title text="{i18n>homeQuickActions}" level="H5" class="sapUiSmallMargin"/>
                                <HBox class="sapUiSmallMargin" wrap="Wrap">
                                <Button text="Mitarbeiter anlegen" icon="sap-icon://add-employee" type="Emphasized" class="cornelsenQuickAction sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onNavWorklist"/>
                                <Button text="Urlaubsantrag" icon="sap-icon://calendar" class="cornelsenQuickAction sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                                <Button text="Zeiterfassung" icon="sap-icon://time-entry-request" class="cornelsenQuickAction sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                                <Button text="Analytik" icon="sap-icon://bar-chart" class="cornelsenQuickAction sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onNavAnalytics"/>
                                <Button text="Org-Chart" icon="sap-icon://org-chart" class="cornelsenQuickAction sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                                </HBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                </layout:content>
            </layout:Grid>

            <layout:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginBottom">
                <layout:content>
                    <f:Card class="cornelsenContentCard sapUiTinyMarginBottom">
                        <f:content>
                            <VBox>
                                <Title text="{i18n>homeRecentHires}" level="H5" class="sapUiSmallMargin"/>
                            <List items="{dashboard>/RecentHires}" showSeparators="Inner">
                                <StandardListItem
                                    title="{dashboard>Name}"
                                    description="{dashboard>Department}"
                                    info="{dashboard>Date}"
                                    icon="{dashboard>Avatar}"
                                    iconInset="false"
                                    type="Active"
                                    press=".onEmployeePress"/>
                            </List>
                            </VBox>
                        </f:content>
                    </f:Card>

                    <f:Card class="cornelsenContentCard sapUiTinyMarginBottom">
                        <f:content>
                            <VBox>
                                <Title text="{i18n>homeUpcomingEvents}" level="H5" class="sapUiSmallMargin"/>
                            <List items="{dashboard>/UpcomingEvents}" showSeparators="Inner">
                                <StandardListItem
                                    title="{dashboard>Title}"
                                    description="{dashboard>Location}"
                                    info="{dashboard>Date}"
                                    icon="sap-icon://appointment-2"
                                    type="Inactive"/>
                            </List>
                            </VBox>
                        </f:content>
                    </f:Card>
                </layout:content>
            </layout:Grid>

            <!-- News -->
            <Title text="{i18n>homeNews}" level="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
            <layout:Grid defaultSpan="L6 M12 S12">
                <layout:content>
                    <f:Card class="cornelsenContentCard sapUiTinyMarginBottom" press=".onNewsPress">
                        <f:content>
                            <VBox>
                                <Image src="{dashboard>/News/0/Image}" width="100%" height="140px" mode="Background"/>
                                <VBox class="sapUiSmallMargin">
                                    <Title text="{dashboard>/News/0/Title}" level="H4" wrapping="true"/>
                                    <Text text="{dashboard>/News/0/Summary}" class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
                                    <Text text="{dashboard>/News/0/Date}" class="sapThemeLightText"/>
                                </VBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <f:Card class="cornelsenContentCard sapUiTinyMarginBottom">
                        <f:content>
                            <VBox>
                                <Image src="{dashboard>/News/1/Image}" width="100%" height="140px" mode="Background"/>
                                <VBox class="sapUiSmallMargin">
                                    <Title text="{dashboard>/News/1/Title}" level="H4" wrapping="true"/>
                                    <Text text="{dashboard>/News/1/Summary}" class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
                                    <Text text="{dashboard>/News/1/Date}" class="sapThemeLightText"/>
                                </VBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                </layout:content>
            </layout:Grid>
        </content>
    </Page>
</mvc:View>
