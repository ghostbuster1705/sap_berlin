{
    "_version": "1.59.0",
    "sap.app": {
        "id": "cornelsen.talent.portal",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "cornelsen.talent.portal.view.App",
            "type": "XML",
            "async": false,
            "id": "appView"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.uxap": { "lazy": true }
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleUrl": "i18n/i18n.properties",
                    "supportedLocales": [""],
                    "fallbackLocale": ""
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "viewPath": "cornelsen.talent.portal.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "async": true
            },
            "routes": [
                { "pattern": "", "name": "home", "target": "home" },
                { "pattern": "worklist", "name": "worklist", "target": "worklist" },
                { "pattern": "employee/{employeeId}", "name": "object", "target": "object" },
                { "pattern": "analytics", "name": "analytics", "target": "analytics" }
            ],
            "targets": {
                "home": {
                    "viewName": "Home",
                    "viewLevel": 1
                },
                "worklist": {
                    "viewName": "Worklist",
                    "viewLevel": 2,
                    "lazy": true
                },
                "object": {
                    "viewName": "ObjectPage",
                    "viewLevel": 3,
                    "lazy": true
                },
                "analytics": {
                    "viewName": "Analytics",
                    "viewLevel": 2,
                    "lazy": true
                }
            }
        },
        "resources": {
            "css": [{ "uri": "css/style.css" }]
        }
    }
}
